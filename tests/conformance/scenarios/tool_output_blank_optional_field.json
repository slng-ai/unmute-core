            {
              "name": "search_web",
              "arguments": {
                "q": "parcel"
              }
            }
          ]
        },
        {
          "site": "",
          "result": "{\"status\": \"in transit\", \"delivered_on\": null}",
          "text": "It is in transit."
        }
      ],
      "spoken": [
        "It is in transit."
      ]
    }
  ],
  "expect": {

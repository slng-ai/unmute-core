{
  "name": "step_handoff_after_tool",
  "about": "A step that calls its own tool, reads the result, then hands off in its next reply, hands off: only the calls of one reply count as beside each other. The opening reply leaves the handoff out.",
  "instructions": "You help callers with their orders.",
  "tasks": {
    "mode": "record",
    "tasks": [
      {
        "name": "find_order",
        "when": "The caller asks about an order.",
        "instructions": "Find order {{order_id}}.",
        "tools": [
          "lookup_order"
        ],
        "assign": [
          {
            "variable": "order_id",
            "path": [
              "order",
              "id"
            ],
            "optional": true
          },
          {
            "variable": "status",
            "path": [
              "status"
            ],
            "optional": true
          }
        ],
        "finish": [
          {
            "tool": "lookup_order",
            "success": {
              "found": [
                true
              ]
            }
          }
        ],
        "handoffs": [
          "to_notes"
        ]
      }
    ],
    "task_only_tools": [
      "lookup_order"
    ]
  },
  "handoffs": {
    "to_notes": "notes"
  },
  "agents": {
    "notes": {
      "instructions": "You take notes.",
      "tools": [
        "search_web"
      ],
      "tasks": {
        "mode": "record",
        "tasks": []
      }
    }
  },
  "turns": [
    {
      "caller": "I need help with an order.",
      "model": [
        {
          "site": "",
          "calls": [
            {
              "name": "find_order"
            }
          ]
        },
        {
          "site": "task:find_order",
          "tools": [
            "lookup_order",
            "finish"
          ],
          "text": "Which order?"
        }
      ],
      "spoken": [
        "Which order?"
      ]
    },
    {
      "caller": "It is A-12. If you cannot find it, put me through to notes.",
      "model": [
        {
          "site": "task:find_order",
          "calls": [
            {
              "name": "lookup_order",
              "arguments": {
                "id": "A-12"
              }
            }
          ],
          "tools": [
            "lookup_order",
            "finish",
            "to_notes"
          ]
        },
        {
          "site": "task:find_order",
          "result": "{\"found\": false}",
          "calls": [
            {
              "name": "to_notes"
            }
          ]
        },
        {
          "site": "",
          "prompt": "You take notes.",
          "heard": [
            "I need help with an order.",
            "It is A-12. If you cannot find it, put me through to notes."
          ],
          "tools": [
            "search_web"
          ],
          "text": "Notes desk."
        }
      ],
      "spoken": [
        "Notes desk."
      ]
    }
  ],
  "expect": {
    "state": {
      "order_id": null,
      "status": null,
      "note": null,
      "tags": []
    },
    "tool_calls": [
      {
        "name": "lookup_order",
        "arguments": {
          "id": "A-12"
        }
      }
    ],
    "events": [
      "task.started task=find_order",
      "task.handed_off task=find_order"
    ],
    "agent": "notes"
  },
  "tool_results": {
    "lookup_order": [
      {
        "found": false
      }
    ]
  }
}

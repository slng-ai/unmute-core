{
  "name": "step_handoff_fresh_step",
  "about": "A step with history reset opens on the step-start cue and asks. When the caller asks to be put through and the step hands off, the next agent never hears the cue as the caller. The step's opening reply leaves the handoff out.",
  "instructions": "You help callers with their orders.",
  "tasks": {
    "mode": "record",
    "tasks": [
      {
        "name": "find_order",
        "when": "The caller asks about an order.",
        "instructions": "Find order {{order_id}}.",
        "tools": [
          "lookup_order"
        ],
        "assign": [
          {
            "variable": "order_id",
            "path": [
              "order",
              "id"
            ],
            "optional": true
          },
          {
            "variable": "status",
            "path": [
              "status"
            ],
            "optional": true
          }
        ],
        "finish": [
          {
            "tool": "lookup_order",
            "success": {
              "found": [
                true
              ]
            }
          }
        ],
        "handoffs": [
          "to_notes"
        ],
        "history": "reset"
      }
    ],
    "task_only_tools": [
      "lookup_order"
    ]
  },
  "handoffs": {
    "to_notes": "notes"
  },
  "agents": {
    "notes": {
      "instructions": "You take notes.",
      "tools": [
        "search_web"
      ],
      "tasks": {
        "mode": "record",
        "tasks": []
      }
    }
  },
  "turns": [
    {
      "caller": "I need help with an order.",
      "model": [
        {
          "site": "",
          "calls": [
            {
              "name": "find_order"
            }
          ]
        },
        {
          "site": "task:find_order",
          "tools": [
            "lookup_order",
            "finish"
          ],
          "text": "Which order?"
        }
      ],
      "spoken": [
        "Which order?"
      ]
    },
    {
      "caller": "Put me through to notes.",
      "model": [
        {
          "site": "task:find_order",
          "tools": [
            "lookup_order",
            "finish",
            "to_notes"
          ],
          "calls": [
            {
              "name": "to_notes"
            }
          ]
        },
        {
          "site": "",
          "prompt": "You take notes.",
          "heard": [
            "Put me through to notes."
          ],
          "order": [
            "assistant",
            "user"
          ],
          "text": "Notes desk."
        }
      ],
      "spoken": [
        "Notes desk."
      ]
    }
  ],
  "expect": {
    "state": {
      "order_id": null,
      "status": null,
      "note": null,
      "tags": []
    },
    "tool_calls": [],
    "events": [
      "task.started task=find_order",
      "task.handed_off task=find_order"
    ],
    "agent": "notes"
  }
}

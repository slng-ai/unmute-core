{
  "name": "handoff_full_tools",
  "about": "A full handoff gives the next agent the tool calls and results of tools it has. It drops a call to a tool it lacks, with its result. A full handoff without tool calls drops every tool call and result, even of a tool the next agent has. Assistant text stays in both.",
  "instructions": "You help callers with their orders.",
  "tasks": {
    "mode": "record",
    "tasks": []
  },
  "handoffs": {
    "to_notes": {
      "to": "notes",
      "context": {
        "history": "full"
      }
    }
  },
  "agents": {
    "notes": {
      "instructions": "You take notes.",
      "tools": [
        "normalize"
      ],
      "tasks": {
        "mode": "record",
        "tasks": []
      },
      "handoffs": {
        "to_desk": {
          "to": "desk",
          "context": {
            "history": "full",
            "include_tool_calls": false
          }
        }
      }
    },
    "desk": {
      "instructions": "You run the front desk.",
      "tools": [
        "normalize"
      ],
      "tasks": {
        "mode": "record",
        "tasks": []
      }
    }
  },
  "tool_results": {
    "search_web": [
      {
        "hours": "9 to 5"
      }
    ]
  },
  "turns": [
    {
      "caller": "Hi.",
      "model": [
        {
          "site": "",
          "text": "Orders here."
        }
      ],
      "spoken": [
        "Orders here."
      ]
    },
    {
      "caller": "When are you open?",
      "model": [
        {
          "site": "",
          "text": "Let me see.",
          "calls": [
            {
              "name": "search_web",
              "arguments": {
                "q": "hours"
              }
            }
          ]
        },
        {
          "site": "",
          "text": "We are open 9 to 5."
        }
      ],
      "spoken": [
        "Let me see.",
        "We are open 9 to 5."
      ]
    },
    {
      "caller": "Put me through to notes.",
      "model": [
        {
          "site": "",
          "calls": [
            {
              "name": "to_notes"
            }
          ]
        },
        {
          "site": "",
          "prompt": "You take notes.",
          "order": [
            "user",
            "assistant",
            "user",
            "assistant",
            "assistant",
            "user"
          ],
          "text": "Notes desk."
        }
      ],
      "spoken": [
        "Notes desk."
      ]
    },
    {
      "caller": "Tidy my note, then put me through to the front desk.",
      "model": [
        {
          "site": "",
          "text": "One moment.",
          "calls": [
            {
              "name": "normalize",
              "arguments": {
                "text": "call me"
              }
            }
          ]
        },
        {
          "site": "",
          "calls": [
            {
              "name": "to_desk"
            }
          ]
        },
        {
          "site": "",
          "prompt": "You run the front desk.",
          "order": [
            "user",
            "assistant",
            "user",
            "assistant",
            "assistant",
            "user",
            "assistant",
            "user",
            "assistant"
          ],
          "text": "Front desk."
        }
      ],
      "spoken": [
        "One moment.",
        "Front desk."
      ]
    }
  ],
  "expect": {
    "state": {
      "order_id": null,
      "status": null,
      "note": null,
      "tags": []
    },
    "tool_calls": [
      {
        "name": "search_web",
        "arguments": {
          "q": "hours"
        }
      },
      {
        "name": "normalize",
        "arguments": {
          "text": "call me"
        }
      }
    ],
    "events": [],
    "agent": "desk"
  }
}

{
  "name": "handoff",
  "about": "The main agent hands the call to a notes agent, which hears only what was said, opens with its own prompt and tools, runs its own task, then hands the call back. The first reply after each handoff offers no handoff tool, so it cannot hand the call straight back; the next one does.",
  "instructions": "You help callers with their orders.",
  "tasks": {
    "mode": "record",
    "tasks": [
      {
        "name": "find_order",
        "when": "The caller asks about an order.",
        "instructions": "Find order {{order_id}}.",
        "tools": ["lookup_order"],
        "assign": [
          {"variable": "order_id", "path": ["order", "id"], "optional": true},
          {"variable": "status", "path": ["status"], "optional": true}
        ],
        "finish": [{"tool": "lookup_order", "success": {"found": [true]}}],
        "announce": ["Let me look."]
      }
    ],
    "task_only_tools": ["lookup_order"]
  },
  "handoffs": {"to_notes": "notes"},
  "agents": {
    "notes": {
      "instructions": "You take notes.",
      "tools": ["search_web"],
      "tasks": {
        "mode": "record",
        "tasks": [
          {
            "name": "take_note",
            "when": "The caller wants a note taken.",
            "instructions": "Take a note.",
            "assign": [{"variable": "note", "path": ["note"], "optional": true}]
          }
        ]
      },
      "handoffs": {"to_orders": "main"}
    }
  },
  "turns": [
    {
      "caller": "Hi.",
      "model": [
        {"site": "", "tools": ["search_web", "normalize", "find_order", "to_notes"], "text": "Orders here."}
      ],
      "spoken": ["Orders here."]
    },
    {
      "caller": "I need a note taken.",
      "model": [
        {"site": "", "calls": [{"name": "to_notes"}]},
        {
          "site": "",
          "prompt": "You take notes.",
          "heard": ["Hi.", "I need a note taken."],
          "tools": ["search_web", "take_note"],
          "text": "Notes desk."
        }
      ],
      "spoken": ["Notes desk."]
    },
    {
      "caller": "Take a note.",
      "model": [
        {"site": "", "calls": [{"name": "take_note"}]},
        {"site": "task:take_note", "text": "What should it say?"}
      ],
      "spoken": ["What should it say?"]
    },
    {
      "caller": "Call me back.",
      "model": [
        {"site": "task:take_note", "calls": [{"name": "finish", "arguments": {"note": "call back"}}]},
        {"site": "", "prompt": "You take notes.", "tools": ["search_web", "take_note", "to_orders"], "text": "Saved."}
      ],
      "spoken": ["Saved."]
    },
    {
      "caller": "Back to orders, please.",
      "model": [
        {"site": "", "calls": [{"name": "to_orders"}]},
        {
          "site": "",
          "prompt": "You help callers with their orders.",
          "tools": ["search_web", "normalize", "find_order"],
          "text": "Orders again."
        }
      ],
      "spoken": ["Orders again."]
    }
  ],
  "expect": {
    "state": {"order_id": null, "status": null, "note": "call back", "tags": []},
    "tool_calls": [],
    "events": [
      "task.started task=take_note",
      "task.completed task=take_note saved=note"
    ],
    "agent": "main"
  }
}

{
  "name": "call_values_in_tool",
  "about": "A tool locks the call's session id and calling number from state.call. A dispatch call object simulates a caller on a web call. After a handoff the other agent's tool reads the same session id, because the call keeps one state.",
  "instructions": "You help callers with their orders.",
  "tasks": {"mode": "record", "tasks": []},
  "call_start": {
    "call": {"direction": "inbound", "calling_number": "+34600111222", "session_id": "s-1"}
  },
  "tool_options": {
    "search_web": {
      "locked": {"session": "{{call.session_id}}", "caller": "{{call.calling_number}}"},
      "parameters": {
        "type": "object",
        "properties": {
          "q": {"type": "string"},
          "session": {"type": "string"},
          "caller": {"type": "string"}
        },
        "required": ["q", "session", "caller"]
      }
    }
  },
  "handoffs": {"to_notes": "notes"},
  "agents": {
    "notes": {
      "instructions": "You take notes.",
      "tools": ["search_web"],
      "tasks": {"mode": "record", "tasks": []}
    }
  },
  "turns": [
    {
      "caller": "When are you open?",
      "model": [
        {"site": "", "calls": [{"name": "search_web", "arguments": {"q": "hours"}}]},
        {"site": "", "text": "We are open 9 to 5."}
      ],
      "spoken": ["We are open 9 to 5."]
    },
    {
      "caller": "I need a note taken.",
      "model": [
        {"site": "", "calls": [{"name": "to_notes"}]},
        {"site": "", "prompt": "You take notes.", "text": "Notes desk."}
      ],
      "spoken": ["Notes desk."]
    },
    {
      "caller": "Is the shop open on Sunday?",
      "model": [
        {"site": "", "calls": [{"name": "search_web", "arguments": {"q": "sunday"}}]},
        {"site": "", "text": "It is closed on Sunday."}
      ],
      "spoken": ["It is closed on Sunday."]
    }
  ],
  "expect": {
    "state": {"order_id": null, "status": null, "note": null, "tags": []},
    "tool_calls": [
      {
        "name": "search_web",
        "arguments": {"q": "hours", "session": "s-1", "caller": "+34600111222"}
      },
      {
        "name": "search_web",
        "arguments": {"q": "sunday", "session": "s-1", "caller": "+34600111222"}
      }
    ],
    "events": [],
    "agent": "notes"
  }
}

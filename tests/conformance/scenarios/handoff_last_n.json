{
  "name": "handoff_last_n",
  "about": "A last_n handoff gives the next agent only the newest items. A reply's text and its tool call count apart. A call and its result stay together.",
  "instructions": "You help callers with their orders.",
  "tasks": {
    "mode": "record",
    "tasks": []
  },
  "handoffs": {
    "to_notes": {
      "to": "notes",
      "context": {
        "history": "last_n",
        "max_messages": 4
      }
    }
  },
  "agents": {
    "notes": {
      "instructions": "You take notes.",
      "tools": [
        "search_web"
      ],
      "tasks": {
        "mode": "record",
        "tasks": []
      }
    }
  },
  "tool_results": {
    "search_web": [
      {
        "hours": "9 to 5"
      }
    ]
  },
  "turns": [
    {
      "caller": "Hi.",
      "model": [
        {
          "site": "",
          "text": "Orders here."
        }
      ],
      "spoken": [
        "Orders here."
      ]
    },
    {
      "caller": "When are you open?",
      "model": [
        {
          "site": "",
          "text": "Let me see.",
          "calls": [
            {
              "name": "search_web",
              "arguments": {
                "q": "hours"
              }
            }
          ]
        },
        {
          "site": "",
          "text": "We are open 9 to 5."
        }
      ],
      "spoken": [
        "Let me see.",
        "We are open 9 to 5."
      ]
    },
    {
      "caller": "Put me through to notes.",
      "model": [
        {
          "site": "",
          "calls": [
            {
              "name": "to_notes"
            }
          ]
        },
        {
          "site": "",
          "prompt": "You take notes.",
          "result": "{\"hours\": \"9 to 5\"}",
          "order": [
            "tool",
            "assistant",
            "user"
          ],
          "text": "Notes desk."
        }
      ],
      "spoken": [
        "Notes desk."
      ]
    }
  ],
  "expect": {
    "state": {
      "order_id": null,
      "status": null,
      "note": null,
      "tags": []
    },
    "tool_calls": [
      {
        "name": "search_web",
        "arguments": {
          "q": "hours"
        }
      }
    ],
    "events": [],
    "agent": "notes"
  }
}
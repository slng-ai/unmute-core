{
  "name": "group_then_transfer",
  "about": "A group whose then is transfer hands the call to the target agent after its last step: the step's words play, then the handoff's line, and the target replies first. It hears the main agent's chat from before the flow, never the main agent's reply. The target runs on its own model, and its first reply offers none of its handoff tools; its next one does.",
  "instructions": "You help callers with their orders.",
  "tasks": {
    "mode": "record",
    "tasks": [
      {
        "name": "take_note",
        "instructions": "Take the caller's note.",
        "assign": [{"variable": "note", "path": ["note"]}]
      }
    ],
    "groups": [
      {
        "name": "leave_note",
        "when": "The caller wants to leave a note.",
        "steps": ["take_note"],
        "context_scope": "shared",
        "then": "transfer",
        "then_target": "notes"
      }
    ]
  },
  "then_targets": {"notes": {"to": "notes", "announce": "Putting you through to notes."}},
  "agents": {
    "notes": {
      "instructions": "You take notes.",
      "tools": ["search_web"],
      "model": "notes-model",
      "tasks": {"mode": "record", "tasks": []},
      "handoffs": {"to_orders": "main"}
    }
  },
  "turns": [
    {
      "caller": "Hi.",
      "model": [{"site": "", "text": "Orders here."}],
      "spoken": ["Orders here."]
    },
    {
      "caller": "I want to leave a note.",
      "model": [
        {"site": "", "calls": [{"name": "leave_note"}]},
        {"site": "task:take_note", "text": "What is your note?"}
      ],
      "spoken": ["What is your note?"]
    },
    {
      "caller": "Call me back tomorrow.",
      "model": [
        {"site": "task:take_note", "model": "scripted", "text": "Noted.", "calls": [{"name": "finish", "arguments": {"note": "call me back tomorrow"}}]},
        {
          "site": "",
          "model": "notes-model",
          "prompt": "You take notes.",
          "heard": ["Hi.", "I want to leave a note."],
          "order": ["user", "assistant", "user", "assistant"],
          "tools": ["search_web"],
          "text": "Notes desk."
        }
      ],
      "spoken": ["Noted.", "Putting you through to notes.", "Notes desk."]
    },
    {
      "caller": "Thanks.",
      "model": [
        {"site": "", "model": "notes-model", "tools": ["search_web", "to_orders"], "text": "Anything else?"}
      ],
      "spoken": ["Anything else?"]
    }
  ],
  "expect": {
    "state": {"order_id": null, "status": null, "note": "call me back tomorrow", "tags": []},
    "tool_calls": [],
    "events": [
      "group.started group=leave_note",
      "group.step_started group=leave_note task=take_note step=0",
      "task.started group=leave_note task=take_note step=0",
      "task.completed group=leave_note task=take_note step=0 saved=note",
      "group.completed group=leave_note"
    ],
    "agent": "notes"
  }
}

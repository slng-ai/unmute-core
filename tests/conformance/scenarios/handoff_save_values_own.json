{
  "name": "handoff_save_values_own",
  "about": "Only the main agent has save_values. The agent it hands the call to gets its own spec: no save tool, and no values block.",
  "instructions": "You help callers with their orders.",
  "save_values": true,
  "tasks": {"mode": "record", "tasks": []},
  "handoffs": {"to_notes": "notes"},
  "agents": {
    "notes": {
      "instructions": "You take notes.",
      "tools": ["search_web"],
      "tasks": {"mode": "record", "tasks": []}
    }
  },
  "turns": [
    {
      "caller": "My order is A-17.",
      "model": [
        {"site": "", "calls": [{"name": "save_values", "arguments": {"order_id": "A-17"}}]},
        {"site": "", "text": "Got it, A-17."}
      ],
      "spoken": ["Got it, A-17."]
    },
    {
      "caller": "I need a note taken.",
      "model": [
        {"site": "", "calls": [{"name": "to_notes"}]},
        {"site": "", "prompt": "You take notes.", "tools": ["search_web"], "text": "Notes desk."}
      ],
      "spoken": ["Notes desk."]
    }
  ],
  "expect": {
    "state": {"order_id": "A-17", "status": null, "note": null, "tags": []},
    "tool_calls": [],
    "events": [],
    "agent": "notes"
  }
}

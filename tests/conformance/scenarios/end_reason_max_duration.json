{
  "name": "end_reason_max_duration",
  "about": "The call runs as long as its limit allows, then ends with no closing line. A tool on the call's end reads the reason, max_duration.",
  "instructions": "You help callers with their orders.",
  "tasks": {
    "mode": "record",
    "tasks": []
  },
  "event_tools": {
    "report": {
      "on": [
        "call_end"
      ],
      "locked": {
        "reason": "{{call.end_reason}}"
      }
    }
  },
  "max_duration_s": 0.6,
  "turns": [
    {
      "caller": "Hi there",
      "model": [
        {
          "site": "",
          "text": "Hello."
        }
      ],
      "spoken": [
        "Hello."
      ]
    }
  ],
  "expect": {
    "state": {
      "order_id": null,
      "status": null,
      "note": null,
      "tags": []
    },
    "tool_calls": [],
    "events": [],
    "ended": true,
    "event_calls": [
      {
        "name": "report",
        "arguments": {
          "reason": "max_duration"
        }
      }
    ]
  }
}

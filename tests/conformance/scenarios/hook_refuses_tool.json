{
  "name": "hook_refuses_tool",
  "about": "A before_tool hook refuses search_web. The tool never runs, and the model reads why it did not.",
  "instructions": "You help callers with their orders.",
  "tasks": {
    "mode": "record",
    "tasks": []
  },
  "tool_results": {
    "search_web": [
      {
        "hours": "9 to 5"
      }
    ]
  },
  "hooks": {
    "refuse": {

{
  "name": "prompt_suffix_tasks",
  "about": "A PromptSuffix hook adds /no_think after every prompt: the main agent's, the task step's and the finish check's. Each request's first system message ends with it.",
  "instructions": "You help callers with their orders.",
  "tasks": {
    "mode": "record",
    "tasks": [
      {
        "name": "take_note",
        "when": "The caller wants to leave a note.",
        "instructions": "Take the caller's note.",
        "assign": [
          {
            "variable": "note",
            "path": [
              "note"
            ]
          }
        ]
      }
    ]
  },
  "hooks": {
    "prompt_suffix": "/no_think"
  },
  "turns": [
    {
      "caller": "I want to leave a note.",
      "model": [
        {
          "site": "",
          "calls": [
            {
              "name": "take_note"
            }
          ],
          "prompt_ends": "\n\n/no_think"
        },
        {
          "site": "task:take_note",
          "text": "What is your note?",
          "prompt_ends": "\n\n/no_think"
        }
      ],
      "spoken": [
        "What is your note?"
      ]
    },
    {
      "caller": "Please call me back.",
      "model": [
        {
          "site": "task:take_note",
          "text": "Noted: please call me back.",
          "prompt_ends": "\n\n/no_think"
        },
        {
          "site": "task:take_note",
          "tool_choice": "required",
          "tools": [
            "finish",
            "not_yet"
          ],
          "calls": [
            {
              "name": "finish",
              "arguments": {
                "note": "please call me back"
              }
            }
          ],
          "prompt_ends": "\n\n/no_think"
        },
        {
          "site": "",
          "text": "Anything else?",
          "prompt_ends": "\n\n/no_think"
        }
      ],
      "spoken": [
        "Noted: please call me back.",
        "Anything else?"
      ]
    }
  ],
  "expect": {
    "state": {
      "order_id": null,
      "status": null,
      "note": "please call me back",
      "tags": []
    },
    "tool_calls": [],
    "events": [
      "task.started task=take_note",
      "task.completed task=take_note saved=note"
    ]
  }
}

{
  "name": "tool_outcome_reply",
  "about": "A tool's own replies turn a typed outcome into a line code says, with no model request, and save what they name: on the main agent, and as a step tool, where the step's own reply is tried first. An outcome no reply matches is answered by the model.",
  "instructions": "You take accident reports.",
  "tasks": {
    "mode": "record",
    "tasks": [
      {
        "name": "report",
        "when": "The caller wants to report an accident.",
        "instructions": "Ask when it happened, and note the day.",
        "tools": ["search_web", "lookup_order"],
        "finish": [{"tool": "lookup_order", "success": {"found": [true]}}],
        "replies": [
          {
            "tool": "search_web",
            "when": {"status": ["future_day"]},
            "say": ["{{result.day}} is still ahead. On which day did it happen?"],
            "assign": [{"variable": "tags", "path": ["day"], "append": true}]
          }
        ]
      }
    ]
  },
  "tool_options": {
    "search_web": {
      "output": {"status": "Literal[\"noted\", \"future_day\"]", "day": "str"},
      "replies": [
        {
          "when": {"status": ["future_day"]},
          "say": ["That day hasn't happened yet. On which day did it happen?"],
          "assign": [{"variable": "note", "path": ["day"]}]
        }
      ]
    }
  },
  "tool_results": {
    "search_web": [
      {"status": "future_day", "day": "next Friday"},
      {"status": "noted", "day": "last Friday"},
      {"status": "future_day", "day": "Friday the 30th"}
    ]
  },
  "turns": [
    {
      "caller": "It happened next Friday.",
      "model": [{"site": "", "calls": [{"name": "search_web", "arguments": {"q": "next Friday"}}]}],
      "spoken": ["That day hasn't happened yet. On which day did it happen?"]
    },
    {
      "caller": "Sorry, last Friday.",
      "model": [
        {"site": "", "calls": [{"name": "search_web", "arguments": {"q": "last Friday"}}]},
        {"site": "", "text": "Thank you, noted."}
      ],
      "spoken": ["Thank you, noted."]
    },
    {
      "caller": "I want to report an accident.",
      "model": [
        {"site": "", "calls": [{"name": "report"}]},
        {"site": "task:report", "text": "When did it happen?"}
      ],
      "spoken": ["When did it happen?"]
    },
    {
      "caller": "Next Friday.",
      "model": [
        {"site": "task:report", "calls": [{"name": "search_web", "arguments": {"q": "next Friday"}}]}
      ],
      "spoken": ["Friday the 30th is still ahead. On which day did it happen?"]
    }
  ],
  "expect": {
    "state": {"order_id": null, "status": null, "note": "next Friday", "tags": ["Friday the 30th"]},
    "tool_calls": [
      {"name": "search_web", "arguments": {"q": "next Friday"}},
      {"name": "search_web", "arguments": {"q": "last Friday"}},
      {"name": "search_web", "arguments": {"q": "next Friday"}}
    ],
    "events": ["task.started task=report"],
    "agent": "a step"
  }
}

{
  "name": "realtime_handoff_full",
  "about": "A handoff that keeps the whole conversation. On a realtime model the next agent's instructions and tools replace the first agent's on the same connection, its line is said first, and the next agent speaks first. The model keeps every earlier turn.",
  "instructions": "You help callers with their orders.",
  "tasks": {"mode": "record", "tasks": []},
  "realtime": true,
  "handoffs": {
    "to_notes": {"to": "notes", "announce": "Putting you through to notes.", "context": {"history": "full"}}
  },
  "agents": {
    "notes": {
      "instructions": "You take notes.",
      "tools": ["search_web"],
      "tasks": {"mode": "record", "tasks": []}
    }
  },
  "turns": [
    {
      "caller": "Hi.",
      "model": [{"site": "", "text": "Orders here."}],
      "spoken": ["Orders here."]
    },
    {
      "caller": "I need a note taken.",
      "model": [
        {"site": "", "tools": ["lookup_order", "search_web", "normalize", "to_notes"], "calls": [{"name": "to_notes"}]},
        {
          "site": "",
          "prompt": "You take notes.",
          "heard": ["Hi.", "I need a note taken."],
          "tools": ["search_web"],
          "text": "Notes desk."
        }
      ],
      "spoken": ["Putting you through to notes.", "Notes desk."]
    }
  ],
  "expect": {
    "state": {"order_id": null, "status": null, "note": null, "tags": []},
    "tool_calls": [],
    "events": [],
    "agent": "notes"
  }
}

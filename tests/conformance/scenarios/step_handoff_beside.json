{
  "name": "step_handoff_beside",
  "about": "A step handoff in the same reply as another call of the step is refused. The other call runs, here a lookup that ends the step, and the main agent answers as usual.",
  "instructions": "You help callers with their orders.",
  "tasks": {
    "mode": "record",
    "tasks": [
      {
        "name": "find_order",
        "when": "The caller asks about an order.",
        "instructions": "Find order {{order_id}}.",
        "tools": [
          "lookup_order"
        ],
        "assign": [
          {
            "variable": "order_id",
            "path": [
              "order",
              "id"
            ],
            "optional": true
          },
          {
            "variable": "status",
            "path": [
              "status"
            ],
            "optional": true
          }
        ],
        "finish": [
          {
            "tool": "lookup_order",
            "success": {
              "found": [
                true
              ]
            }
          }
        ],
        "handoffs": [
          "to_notes"
        ]
      }
    ],
    "task_only_tools": [
      "lookup_order"
    ]
  },
  "handoffs": {
    "to_notes": "notes"
  },
  "agents": {
    "notes": {
      "instructions": "You take notes.",
      "tools": [
        "search_web"
      ],
      "tasks": {
        "mode": "record",
        "tasks": []
      }
    }
  },
  "tool_results": {
    "lookup_order": [
      {
        "found": true,
        "order": {
          "id": "A-12"
        },
        "status": "open"
      }
    ]
  },
  "turns": [
    {
      "caller": "I need help with an order.",
      "model": [
        {
          "site": "",
          "calls": [
            {
              "name": "find_order"
            }
          ]
        },
        {
          "site": "task:find_order",
          "text": "Which order?"
        }
      ],
      "spoken": [
        "Which order?"
      ]
    },
    {
      "caller": "Put me through to notes, after you find A-12.",
      "model": [
        {
          "site": "task:find_order",
          "calls": [
            {
              "name": "to_notes"
            },
            {
              "name": "lookup_order",
              "arguments": {
                "id": "A-12"
              }
            }
          ]
        },
        {
          "site": "",
          "prompt": "You help callers with their orders.",
          "text": "Order A-12 is open."
        }
      ],
      "spoken": [
        "Order A-12 is open."
      ]
    }
  ],
  "expect": {
    "state": {
      "order_id": "A-12",
      "status": "open",
      "note": null,
      "tags": []
    },
    "tool_calls": [
      {
        "name": "lookup_order",
        "arguments": {
          "id": "A-12"
        }
      }
    ],
    "events": [
      "task.started task=find_order",
      "task.ended_on_tool task=find_order saved=order_id,status",
      "task.completed task=find_order saved=order_id,status"
    ]
  }
}
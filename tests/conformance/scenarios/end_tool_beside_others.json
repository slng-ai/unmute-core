{
  "name": "end_tool_beside_others",
  "about": "A model says goodbye and asks for two lookups in the same reply, with the tool that ends the conversation between them. Every tool runs, the call ends after that reply, and the model is not asked again. A tool on the call's end reads the reason, agent_ended.",
  "instructions": "You help callers with their orders.",
  "tasks": {
    "mode": "record",
    "tasks": []
  },
  "tool_options": {
    "normalize": {
      "effect": "ends_conversation"
    }
  },
  "event_tools": {
    "report": {
      "on": [
        "call_end"
      ],
      "locked": {
        "reason": "{{call.end_reason}}"
      }
    }
  },
  "turns": [
    {
      "caller": "That is all, bye.",
      "model": [
        {
          "site": "",
          "text": "Goodbye!",
          "calls": [
            {
              "name": "search_web",
              "arguments": {
                "q": "hours"
              }
            },
            {
              "name": "normalize",
              "arguments": {
                "reason": "done"
              }
            },
            {
              "name": "search_web",
              "arguments": {
                "q": "address"
              }
            }
          ]
        }
      ],
      "spoken": [
        "Goodbye!"
      ]
    }
  ],
  "expect": {
    "state": {
      "order_id": null,
      "status": null,
      "note": null,
      "tags": []
    },
    "tool_calls": [
      {
        "name": "search_web",
        "arguments": {
          "q": "hours"
        }
      },
      {
        "name": "normalize",
        "arguments": {
          "reason": "done"
        }
      },
      {
        "name": "search_web",
        "arguments": {
          "q": "address"
        }
      }
    ],
    "events": [],
    "ended": true,
    "event_calls": [
      {
        "name": "report",
        "arguments": {
          "reason": "agent_ended"
        }
      }
    ],
    "opening": [
      "Hello, this is the order desk."
    ]
  },
  "tool_results": {
    "search_web": [
      {
        "hours": "9 to 5"
      },
      {
        "address": "Main Street 1"
      }
    ]
  },
  "greeting": "Hello, this is the order desk.",
  "realtime": true
}

{
  "name": "end_reason_tool_realtime",
  "about": "A tool that ends the conversation ends the call on a realtime model too, with no second request after it. The call opens with a fixed line, so the model already has its context when the tool runs.",
  "instructions": "You help callers with their orders.",
  "tasks": {
    "mode": "record",
    "tasks": []
  },
  "tool_options": {
    "normalize": {
      "effect": "ends_conversation"
    }
  },
  "event_tools": {
    "report": {
      "on": [
        "call_end"
      ],
      "locked": {
        "reason": "{{call.end_reason}}"
      }
    }
  },
  "turns": [
    {
      "caller": "That is all, bye.",
      "model": [
        {
          "site": "",
          "text": "Goodbye!",
          "calls": [
            {
              "name": "normalize",
              "arguments": {
                "reason": "done"
              }
            }
          ]
        }
      ],
      "spoken": [
        "Goodbye!"
      ]
    }
  ],
  "expect": {
    "state": {
      "order_id": null,
      "status": null,
      "note": null,
      "tags": []
    },
    "tool_calls": [
      {
        "name": "normalize",
        "arguments": {
          "reason": "done"
        }
      }
    ],
    "events": [],
    "ended": true,
    "event_calls": [
      {
        "name": "report",
        "arguments": {
          "reason": "agent_ended"
        }
      }
    ],
    "opening": [
      "Hello, this is the order desk."
    ]
  },
  "greeting": "Hello, this is the order desk.",
  "realtime": true
}

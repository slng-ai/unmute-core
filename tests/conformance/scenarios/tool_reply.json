{
  "name": "tool_reply",
  "about": "A step tool's result is answered by a fixed line from code, with no model request. A result the rule does not match is answered by the model.",
  "instructions": "You help callers with their orders.",
  "tasks": {
    "mode": "record",
    "tasks": [
      {
        "name": "find_order",
        "when": "The caller asks about an order.",
        "instructions": "Ask for the order number, then find the order.",
        "tools": ["lookup_order", "search_web"],
        "assign": [
          {"variable": "order_id", "path": ["order", "id"], "optional": true},
          {"variable": "status", "path": ["status"], "optional": true}
        ],
        "finish": [{"tool": "lookup_order", "success": {"found": [true]}}],
        "replies": [
          {
            "tool": "search_web",
            "when": {"state": ["open"]},
            "say": ["Order {{result.order}} is open. Shall I close it?"]
          }
        ]
      }
    ],
    "task_only_tools": ["lookup_order"]
  },
  "tool_results": {
    "search_web": [{"order": "B-7", "state": "lost"}, {"order": "A-12", "state": "open"}],
    "lookup_order": [{"found": true, "order": {"id": "A-12"}, "status": "closed"}]
  },
  "turns": [
    {
      "caller": "Where is my order?",
      "model": [
        {"site": "", "calls": [{"name": "find_order"}]},
        {"site": "task:find_order", "text": "What is the order number?"}
      ],
      "spoken": ["What is the order number?"]
    },
    {
      "caller": "It is B-7.",
      "model": [
        {"site": "task:find_order", "calls": [{"name": "search_web", "arguments": {"q": "B-7"}}]},
        {"site": "task:find_order", "text": "I cannot find B-7. Do you have another number?"}, {"site": "task:find_order", "tool_choice": "required", "tools": ["finish", "not_yet"], "calls": [{"name": "not_yet"}]}
      ],
      "spoken": ["I cannot find B-7. Do you have another number?"]
    },
    {
      "caller": "Try A-12.",
      "model": [
        {"site": "task:find_order", "calls": [{"name": "search_web", "arguments": {"q": "A-12"}}]}
      ],
      "spoken": ["Order A-12 is open. Shall I close it?"]
    },
    {
      "caller": "Yes.",
      "model": [
        {"site": "task:find_order", "order": ["user", "assistant", "user", "tool", "assistant", "user", "tool", "assistant", "user"], "calls": [{"name": "lookup_order", "arguments": {"order_id": "A-12"}}]},
        {"site": "", "text": "It is closed."}
      ],
      "spoken": ["It is closed."]
    }
  ],
  "expect": {
    "state": {"order_id": "A-12", "status": "closed", "note": null, "tags": []},
    "tool_calls": [
      {"name": "search_web", "arguments": {"q": "B-7"}},
      {"name": "search_web", "arguments": {"q": "A-12"}},
      {"name": "lookup_order", "arguments": {"order_id": "A-12"}}
    ],
    "events": [
      "task.started task=find_order",
      "task.ended_on_tool task=find_order saved=order_id,status",
      "task.completed task=find_order saved=order_id,status"
    ]
  }
}

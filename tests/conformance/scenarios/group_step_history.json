{
  "name": "group_step_history",
  "about": "In a shared group, each step opens on its own history value. The first step uses the group's history. The step after the tool step uses full and hears the tool call and result. The last step uses messages and hears only what was said.",
  "instructions": "You help callers with their orders.",
  "tasks": {
    "mode": "record",
    "tasks": [
      {
        "name": "find_order",
        "instructions": "Find order {{order_id}}.",
        "tools": [
          "lookup_order"
        ],
        "assign": [
          {
            "variable": "order_id",
            "path": [
              "order",
              "id"
            ],
            "optional": true
          },
          {
            "variable": "status",
            "path": [
              "status"
            ],
            "optional": true
          }
        ],
        "finish": [
          {
            "tool": "lookup_order",
            "success": {
              "found": [
                true
              ]
            }
          }
        ],
        "announce": [
          "Let me look."
        ]
      },
      {
        "name": "take_note",
        "instructions": "Take a note.",
        "assign": [
          {
            "variable": "note",
            "path": [
              "note"
            ],
            "optional": true
          }
        ],
        "history": "full"
      },
      {
        "name": "tag_order",
        "instructions": "Tag the order.",
        "assign": [
          {
            "variable": "tags",
            "path": [
              "tags"
            ],
            "optional": true
          }
        ],
        "history": "messages"
      }
    ],
    "groups": [
      {
        "name": "order_flow",
        "when": "The caller wants help with an order.",
        "steps": [
          "find_order",
          "take_note",
          "tag_order"
        ],
        "context_scope": "shared"
      }
    ],
    "task_only_tools": [
      "lookup_order"
    ]
  },
  "tool_results": {
    "lookup_order": [
      {
        "found": true,
        "order": {
          "id": "A-12"
        },
        "status": "open"
      }
    ]
  },
  "turns": [
    {
      "caller": "I need help with my order.",
      "model": [
        {
          "site": "",
          "calls": [
            {
              "name": "order_flow"
            }
          ]
        },
        {
          "site": "task:find_order",
          "heard": [
            "I need help with my order."
          ],
          "text": "What is the order number?"
        }
      ],
      "spoken": [
        "Let me look.",
        "What is the order number?"
      ]
    },
    {
      "caller": "It is A-12.",
      "model": [
        {
          "site": "task:find_order",
          "heard": [
            "I need help with my order.",
            "It is A-12."
          ],
          "calls": [
            {
              "name": "lookup_order",
              "arguments": {
                "order_id": "A-12"
              }
            }
          ]
        },
        {
          "site": "task:take_note",
          "heard": [
            "I need help with my order.",
            "It is A-12."
          ],
          "text": "Any note to add?",
          "order": [
            "user",
            "assistant",
            "assistant",
            "user",
            "tool"
          ]
        }
      ],
      "spoken": [
        "Any note to add?"
      ]
    },
    {
      "caller": "Mark it urgent.",
      "model": [
        {
          "site": "task:take_note",
          "heard": [
            "I need help with my order.",
            "It is A-12.",
            "Mark it urgent."
          ],
          "text": "Noted.",
          "calls": [
            {
              "name": "finish",
              "arguments": {
                "note": "urgent"
              }
            }
          ]
        },
        {
          "site": "task:tag_order",
          "heard": [
            "I need help with my order.",
            "It is A-12.",
            "Mark it urgent."
          ],
          "order": [
            "user",
            "assistant",
            "assistant",
            "user",
            "assistant",
            "user",
            "assistant"
          ],
          "text": "Any tag?"
        }
      ],
      "spoken": [
        "Noted.",
        "Any tag?"
      ]
    },
    {
      "caller": "Tag it rush.",
      "model": [
        {
          "site": "task:tag_order",
          "text": "Tagged.",
          "calls": [
            {
              "name": "finish",
              "arguments": {
                "tags": [
                  "rush"
                ]
              }
            }
          ]
        },
        {
          "site": "",
          "heard": [
            "I need help with my order."
          ],
          "text": "Anything else?"
        }
      ],
      "spoken": [
        "Tagged.",
        "Anything else?"
      ]
    }
  ],
  "expect": {
    "state": {
      "order_id": "A-12",
      "status": "open",
      "note": "urgent",
      "tags": [
        "rush"
      ]
    },
    "tool_calls": [
      {
        "name": "lookup_order",
        "arguments": {
          "order_id": "A-12"
        }
      }
    ],
    "events": [
      "group.started group=order_flow",
      "group.step_started group=order_flow task=find_order step=0",
      "task.started group=order_flow task=find_order step=0",
      "task.ended_on_tool group=order_flow task=find_order step=0 saved=order_id,status",
      "task.completed group=order_flow task=find_order step=0 saved=order_id,status",
      "group.step_started group=order_flow task=take_note step=1",
      "task.started group=order_flow task=take_note step=1",
      "task.completed group=order_flow task=take_note step=1 saved=note",
      "group.step_started group=order_flow task=tag_order step=2",
      "task.started group=order_flow task=tag_order step=2",
      "task.completed group=order_flow task=tag_order step=2 saved=tags",
      "group.completed group=order_flow"
    ]
  }
}

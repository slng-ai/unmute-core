{
  "agents": [
    "concierge"
  ],
  "bindings": [
    {
      "binding": {
        "language": "en",
        "model": "soniox/speech-ai:rt-v5",
        "params": {
          "world_part": "eu-north"
        },
        "placement": "api",
        "provider": "slng"
      },
      "role": "listen",
      "target": "pipecat"
    },
    {
      "binding": {
        "endpointing_delay": "200ms",
        "model": "silero",
        "pace": "snappy",
        "placement": "local",
        "provider": "local"
      },
      "role": "turn",
      "target": "pipecat"
    },
    {
      "binding": {
        "language": "en",
        "model": "cartesia/sonic:3.5",
        "params": {
          "warm_standby_enabled": true,
          "world_part": "eu-north"
        },
        "placement": "api",
        "provider": "slng",
        "voice": "62ae83ad-4f6a-430b-af41-a9bede9286ca"
      },
      "profile": "voice",
      "role": "speak",
      "target": "pipecat"
    },
    {
      "binding": {
        "model": "gemini-3.1-flash-lite",
        "params": {
          "location": "eu",
          "thinking_config": {
            "thinking_level": "MINIMAL"
          },
          "vertexai": true
        },
        "placement": "api",
        "provider": "google"
      },
      "profile": "reasoning",
      "role": "reason",
      "target": "pipecat"
    }
  ],
  "deployment_regions": [
    "eu-central"

# Gemini on Vertex AI (an API key with Vertex access)
GOOGLE_API_KEY=
# Embeddings for the two knowledge bases
OPENAI_API_KEY=
# SLNG speech-to-text and text-to-speech
SLNG_API_KEY=

# Optional. Tracing starts only when these are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional. Simulates a phone caller on a console or browser call, as a dispatch's
# call_start would. Verification then reads the number back instead of asking for it.
# UNMUTE_CALL_START={"call": {"direction": "inbound", "calling_number": "+34612345678"}}
UNMUTE_CALL_START=
# Optional. Another Gemini model to compare against, like gemini-3.5-flash-lite.
LLM_MODEL=

# Optional. The name a dispatch asks for, like a SIP dispatch rule. Empty takes every room.
LIVEKIT_AGENT_NAME=
# Optional. Set to 1 so a phone call's caller ID is not used, as when a test caller
# should be asked for their number.
IGNORE_CALLER_ID=

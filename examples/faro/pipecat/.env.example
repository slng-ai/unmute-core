# SLNG: speech to text (Soniox) and text to speech (Fish Audio), in eu-north
SLNG_API_KEY=
# Vertex AI API key, for Gemini 3.1 Flash Lite on the EU endpoint
GOOGLE_API_KEY=

# Optional. Defaults shown.
# SLNG_WORLD_PART=eu-north
# VERTEX_LOCATION=eu
# LLM_MODEL=gemini-3.1-flash-lite

# LiveKit project

# Optional. Tracing starts only when these are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional. Where learners are kept (default faro.sqlite3 here).
# FARO_DB=faro.sqlite3
# Optional. Simulates a caller ID on a console or browser call.
# UNMUTE_CALL_START={"call": {"direction": "inbound", "calling_number": "+34600555666"}}

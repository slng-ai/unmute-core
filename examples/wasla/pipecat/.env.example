# SLNG: speech to text (Soniox) and text to speech (Fish Audio), in eu-north
SLNG_API_KEY=
# Vertex AI API key, for Gemini 3.1 Flash Lite on the EU endpoint
GOOGLE_API_KEY=

# Optional. Defaults shown.
# SLNG_WORLD_PART=eu-north
# VERTEX_LOCATION=eu
# LLM_MODEL=gemini-3.1-flash-lite

# LiveKit project

# Optional. Tracing starts only when these are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Required on a console or browser call: the account the call is about. A real dispatch
# sends it as its call_start object instead. Without it, the call does not start.
UNMUTE_CALL_START={"account_id": "WA-1001"}

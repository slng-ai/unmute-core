# SLNG: the Context Router for the model, and speech-to-text and text-to-speech
SLNG_API_KEY=
# Optional. Another router region, or another model the router config expects.
# Defaults: the EU router and gpt-5.6-luna (desk.agent.RouterSettings).
SLNG_ROUTER_URL=
SLNG_MODEL=

# Optional. Tracing starts only when these are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional. Simulates a phone caller on a console or browser call, as a dispatch's
# call_start would.
# UNMUTE_CALL_START={"call": {"direction": "inbound", "calling_number": "+447911123456"}}
UNMUTE_CALL_START=
# Optional. The name a dispatch asks for, like a SIP dispatch rule. Empty takes every room.
LIVEKIT_AGENT_NAME=
